{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-api",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/Chronos.Api/Chronos.Api.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "npm-install-frontend",
      "type": "shell",
      "command": "npm install",
      "options": {
        "cwd": "${workspaceFolder}/frontend/chronos-web"
      },
      "problemMatcher": []
    },
    {
      "label": "start-frontend",
      "type": "shell",
      "command": "npm start",
      "options": {
        "cwd": "${workspaceFolder}/frontend/chronos-web"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "angular",
        "pattern": {
          "regexp": "^ERROR.*$",
          "file": 1,
          "location": 1,
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Generating browser application bundles|Application bundle generation",
          "endsPattern": "Compiled successfully|Application bundle generation complete|Watch mode enabled"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "chronos"
      }
    }
  ]
}
