{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "frontend/chronos-web/",
      "framework": "angular"
    },
    "api": {
      "root": "src/",
      "runtime": "container",
      "entrypoint": "Chronos.Api/Dockerfile"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
